# 操作系统
Thumbs.db
.DS_Store
desktop.ini
ehthumbs.db
Desktop.ini

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Node.js (避免误提交)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/

# 临时验证脚本 (Phase 2 verify, 不进 commit)
docs/verify/

# 浏览器 / 工具
screenshots/
*.log

# 临时文件
*.tmp
*.bak
*.orig
*.rej
.cache/
.tmp/                  # 工作区临时目录 (脚本/测试/cleanup backup)

# Skill 工作文件 (brainstorm session state, planning 中间产物, 不入 git)
.superpowers/

# 仓库相关（不提交上游整包，.minimax/skills/ 是单独维护的精简版）
.minimax/repos/
.minimax/.cache/

# 但保留 .minimax/skills/ 下的所有 skill
!.minimax/skills/
!.minimax/skills/**/

# 协议文档守门（v1.3.11+）: docs/protocol/ + docs/reference/ 是公司/客户产品协议，
# 内含 BMS / EMS 协议 v1.13 / v1.4.3 等敏感信息，永不入 git
# 详细守门规则见 docs/protocol/SKILL-NO-PUSH.md
docs/protocol/
docs/reference/
# 例外: README.md 守门文件本身可以入 git
!docs/protocol/README.md
!docs/protocol/SKILL-NO-PUSH.md

# 环境变量 / 凭据
.env
.env.local
*.pem
*.key
